# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
# Enter your MongoDB Atlas connection string here.
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/stock_manager?retryWrites=true&w=majority
# If left empty in development, the system will use an internal in-memory replica set fallback for local testing.
MONGODB_URI=

# JWT Authentication. Set a unique secret of at least 32 characters privately.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Intended administrator. Set ADMIN_PASSWORD privately; never commit its value.
ADMIN_NAME=Tanish Technology
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allowed Frontend Client URL for CORS & Cookies
CLIENT_URL=http://localhost:5173

